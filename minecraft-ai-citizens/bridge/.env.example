# Copy to .env (or just export these) before running the bridge.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Where the bridge listens. The add-on's default bridge URL is
# http://127.0.0.1:8787, so keep these unless you change it in game with
#   !ai bridge http://<host>:<port>
PORT=8787
HOST=127.0.0.1

# Optional shared secret. If set, the add-on must send the same value:
#   !ai config bridgeToken my-secret
AI_CITIZENS_TOKEN=

# Model. Leave this alone unless you know you want something else -
# claude-opus-5 is the most capable model and what the citizens are tuned for.
CLAUDE_MODEL=claude-opus-5

# How hard Claude thinks per request kind. low | medium | high | xhigh | max
# Routine ticks happen constantly, so they run cheap; talking to a player is
# where the quality shows.
EFFORT_TICK=low
EFFORT_CHAT=medium
EFFORT_CONVERSE=low
EFFORT_GROUP=medium

# Safety valves.
MAX_CONCURRENT=6
REQUEST_TIMEOUT_MS=20000
DAILY_TOKEN_BUDGET=0        # 0 = unlimited; otherwise the bridge stops when hit
LOG_DECISIONS=false         # print every reply (noisy, useful while tuning)
